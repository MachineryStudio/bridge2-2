{
  "name": "VerbTag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Tag name (e.g. 'Work Verbs', 'Travel Verbs')"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the tag",
      "default": "#6366f1"
    },
    "verb_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of verb IDs assigned to this tag",
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}